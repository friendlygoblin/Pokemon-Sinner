mapscripts PortraitTown_MapScripts {}

script PortraitTown_ConcertHallSign{
    lock
    msgbox(format("PORTRAIT TOWN CONCERT HALL\p MARINA IS WAITING FOR YOU"))
    release
    end
}

script PortraitTown_CitySign{
    lock
    msgbox(format("Welcome to Portrait Town!\p So lovely you'll want to visit over and over again!"))
    release
    end
}

script PortraitTown_CableCarSign{
    lock
    msgbox(format("{UP_ARROW}: Cable Car station\pRide the Cable Car down to Route 9!"))
    release
    end
}

script PortraitTown_Route8Sign{
    lock
    msgbox(format("{DOWN_ARROW}: Route 8, to Mercy Town."))
    release
    end
}

script PortraitTown_Girl{
    lock
    faceplayer
    msgbox(format("It's pretty cold in this town.\pThat's why Ice Type POKéMON thrive here!"))
    release
    end
}

script PortraitTown_Man{
    lock
    faceplayer
    msgbox(format("Marina? Oh no, I'm too old to attend her shows… \pBut my kids aren't, so I go with them!"))
    release
    end
}