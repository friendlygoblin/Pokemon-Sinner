mapscripts Route2_MapScripts {}

const Jay = 1

script Route2_Jay{
	trainerbattle_single(TRAINER_SAWYER_1, Jay_BattleIntro, Jay_Defeated, Route2_Jay_PostBattle)
	goto(Route2_Jay_PostBattle)
}

script Route2_Jay_PostBattle{
    msgbox(Jay_PostBattle, MSGBOX_AUTOCLOSE)
    delay(40)
    applymovement(Jay, JayLeaves_Route2)
    waitmovement(0)
    removeobject(Jay)
    setflag(FLAG_JAY_ROUTE2)
    release
    end
}

text Jay_BattleIntro{
    "JAY: Hey you!\p"
    "I'm training for the TLDP challenge! \p"
    "Train with me!$"
}

text Jay_Defeated{
    "Guess I need to train more…$"
}

text Jay_PostBattle{
    "JAY: Well, it looks like you're closer \n"
    "to being ready for this than I am.\p"
    "I'm gonna train a bit further, I've \n"
    "heard there are strong trainers on \l"
    "the other side of the Rib Cave.$"
}

movement JayLeaves_Route2 {
    walk_down * 6
    step_end
}

script Route2_Hiker {
    trainerbattle_single(TRAINER_TOMMY, format("I was just taking a break from walking, but I always have energy for a POKéMON battle!$"), format("I need to sit down again…$"))
    msgbox(format("I like to find cosy little spots to take naps in. \pToo bad I have to walk so much to get there.$"), MSGBOX_AUTOCLOSE)
}

script Route2_SchoolGirl {
    trainerbattle_single(TRAINER_KAREN_1, format("I did my school presentation about my POKéMON!"), format("But I got a good grade… "))
    msgbox(format("Munchlax helped me prepare my presentation!\pHe's my best friend!"), MSGBOX_AUTOCLOSE)
}

script RibCave_Sign{
    lock
    msgbox(format("{UP_ARROW} Rib Cave.\pGateway to Candlewax City."))
    releaseall
    end
}