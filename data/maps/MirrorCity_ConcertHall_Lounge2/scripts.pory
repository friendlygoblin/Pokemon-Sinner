mapscripts MirrorCity_ConcertHall_Lounge2_MapScripts {}

const Katherine = 1
const Ella = 2
const Harv = 3
const Ale = 4
const Pau = 5
const Dany = 6
const Luvcat = 7
const Cal = 8
const Nora = 9

script MCCH_LoungeHarv{
    lock
    faceplayer
    msgbox(LoungeHarv_OfferBattle, MSGBOX_YESNO)
    if(var(VAR_RESULT)==YES){
        msgbox(LoungeHarv_AcceptBattle, MSGBOX_AUTOCLOSE)
        trainerbattle_no_intro(TRAINER_HARV_2, format("Cut!\nWait that's right I'm not at work… "))
        msgbox(LoungeHarv_PostBattle, MSGBOX_AUTOCLOSE)
    }
    else{
        msgbox(LoungeHarv_RefuseBattle, MSGBOX_AUTOCLOSE)
    }
    applymovement(Harv, Common_Movement_FaceUp)
    release
    end
}

text LoungeHarv_OfferBattle{
    "HARV: Hey, that's my new movie star! \p"
    "How have you been? \p"
    "I'm not filming anything today, or \n"
    "at least not for work. \p"
    "I'm here to see my friends, The Last \n"
    "Dinner Party! \p"
    "We have a minute before the show  \n"
    "starts, would you like to have a \l"
    "quick battle? $"
    }

text LoungeHarv_RefuseBattle{
    "No worries, you know where to find \n"
    "me if you change your mind. $"
    }

text LoungeHarv_AcceptBattle{
    "Aaand… ACTION! $"
    }

text LoungeHarv_PostBattle{
    "You really have a unique style, have \n"
    "you ever considered being an actor? \p"
    "I know who to call if I ever need \n"
    "extras again, until then good luck \l"
    "against the band! $"
}

