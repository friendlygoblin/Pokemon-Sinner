script MCCH_LoungeKatherine{
    lock
    faceplayer
    msgbox(LoungeKatherine_OfferBattle, MSGBOX_YESNO)
    if(var(VAR_RESULT)==YES){
        specialvar(VAR_RESULT, CalculatePlayerPartyCount)
        if(var(VAR_RESULT)==1){
            msgbox(format("Wait, we only do double battles and you only have one POKéMON… \pCome back when you have at least two on your team!"))
        }
        else{
            msgbox(LoungeKatherine_AcceptBattle)
            msgbox(LoungeElla_AcceptBattleFromKatherine, MSGBOX_AUTOCLOSE)
            trainerbattle_no_intro(TRAINER_PICTURE_PARLOUR_2, format("KATHERINE: Yup, still super cool!\pELLA: You rock! "))
            msgbox(LoungeKatherine_PostBattle, MSGBOX_AUTOCLOSE)
        }
    }
    else{
        msgbox(LoungeKatherine_RefuseBattle, MSGBOX_AUTOCLOSE)
    }
    applymovement(Katherine, Common_Movement_FaceRight)
    release
    end
}

text LoungeKatherine_OfferBattle{
    "KATHERINE: Hey, you're the one from the \n"
    "music video! \p"
    "You're here for the TLDP challenge? \p"
    "Ella and I are just here to watch the \n"
    "show, but that sounds fun!\p"
    "I know they don't do double battles, \n"
    "but wanna train with us? $"
    }

text LoungeKatherine_RefuseBattle{
    "Bummer, well we'll be waitin' here if \n"
    "you need us. $"
    }

text LoungeKatherine_AcceptBattle{
    "Alright! Ella? $"
    }

text LoungeKatherine_AcceptBattleFromElla{
    "KATHERINE: On it!$"
    }

text LoungeKatherine_PostBattle{
    "Just as cool as on set! \p"
    "You'll come visit us if we set up our\n"
    "own challenge, will ya? $"
}

script MCCH_LoungeElla{
    lock
    faceplayer
    msgbox(LoungeElla_OfferBattle, MSGBOX_YESNO)
    if(var(VAR_RESULT)==YES){
        specialvar(VAR_RESULT, CalculatePlayerPartyCount)
        if(var(VAR_RESULT)==1){
            msgbox(format("Wait, we only do double battles and you only have one POKéMON… \pThat wouldn't be fair, come back with more POKéMON, we'll wait right here."))
        }
        else{
            msgbox(LoungeElla_AcceptBattle)
            msgbox(LoungeKatherine_AcceptBattleFromElla, MSGBOX_AUTOCLOSE)
            trainerbattle_no_intro(TRAINER_PICTURE_PARLOUR_2, format("KATHERINE: Yup, still super cool!\pELLA: You rock! "))
            msgbox(LoungeKatherine_PostBattle, MSGBOX_AUTOCLOSE)
        }
    }
    else{
        msgbox(LoungeElla_RefuseBattle, MSGBOX_AUTOCLOSE)
    }
    applymovement(Ella, Common_Movement_FaceDown)
    release
    end
}

text LoungeElla_OfferBattle{
    "ELLA: Hey, I remember you, you starred \n"
    "in our music video! \p"
    "Thanks again for that. \p"
    "Wanna double battles again, consider \n"
    "it training for TLDP? $"
    }

text LoungeElla_RefuseBattle{
    "That's fine, we'll just chill here  \n"
    "waitin' for the show to start. $"
    }

text LoungeElla_AcceptBattle{
    "Cool! Katherine? $"
    }

text LoungeElla_AcceptBattleFromKatherine{
    "ELLA: Be right there!$"
    }

text LoungeElla_PostBattle{
    "Hell yeah, that was cool! \p"
    "Good luck out there, hope you'll \n"
    "come to us when we're big enough \l"
    "to have our own challenge! $"
}

