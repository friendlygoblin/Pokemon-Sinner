mapscripts PortraitTown_ConcertHall_Lobby_MapScripts {}

const Abi = 2

script MarinaHall_Ann{
    lock
    faceplayer
    if(defeated(TRAINER_MARINA)){
        msgbox(format("ANN: I thought you couldn't break a diamond… but you've done it!"), MSGBOX_AUTOCLOSE)
        }
    else{
        msgbox(format("ANN: I'll win this for Cowboy Lizzie!"),MSGBOX_AUTOCLOSE)
        trainerbattle_no_intro(TRAINER_ANN_2,  format("Cowboy Lizzie lives on… even without me."))
        msgbox(format("ANN: I thought you couldn't break a diamond… but you've done it!"), MSGBOX_AUTOCLOSE)
        }
    releaseall
    end
}

script MarinaHall_Brenae{
    lock
    faceplayer
    if(defeated(TRAINER_MARINA)){
        msgbox(format("BRENAE: So, how was Marina?\pI bet she was amazing!"), MSGBOX_AUTOCLOSE)
        }
    else{
        msgbox(format("BRENAE: I get nervous before concerts, and I'm challenging Marina so it's even worse this time!"),MSGBOX_AUTOCLOSE)
        trainerbattle_no_intro(TRAINER_BRENAE_2,  format("Mmh, I'm still nervous… "))
        msgbox(format("BRENAE: I can't wait to see Marina, I hope I don't liquefy when I face her… "), MSGBOX_AUTOCLOSE)
        }
    releaseall
    end
}

script MarinaHall_Gosia{
    lock
    faceplayer
    if(defeated(TRAINER_MARINA)){
        msgbox(format("GOSIA: You won against Marina?\pNo way!"), MSGBOX_AUTOCLOSE)
        }
    else{
        msgbox(format("GOSIA: I'm one of Marina's biggest fans, ask me anything about her!"),MSGBOX_AUTOCLOSE)
        trainerbattle_no_intro(TRAINER_GOSIA,  format("I'm so excited to see Marina I wasn't completely focused."))
        msgbox(format("GOSIA: Come to me if you have any question about Marina!"), MSGBOX_AUTOCLOSE)
        }
    releaseall
    end
}

script MarinaHall_Abi{
    lock
    applymovement(Abi, MarinaHall_AbiWalkToPlayer)
    waitmovement(0)
    msgbox(MarinaHall_AbiTalkToPlayer, MSGBOX_AUTOCLOSE)
    applymovement(OBJ_EVENT_ID_PLAYER, MarinaHall_PlayerMoveAside)
    waitmovement(0)
    applymovement(Abi, MarinaHall_AbiLeaves)
    waitmovement(0)
    removeobject(Abi)
    setflag(FLAG_MARINAHALL_ABI)
    setvar(VAR_MARINAHALL_ABI,1)
    release
    end
}

movement MarinaHall_AbiWalkToPlayer{
    walk_down *5
    step_end
}

movement MarinaHall_AbiLeaves{
    walk_down *2
    step_end
}

movement MarinaHall_PlayerMoveAside{
    walk_right
    face_left
    step_end
}

text MarinaHall_AbiTalkToPlayer{
    "ABIGAIL: {PLAYER}! \p"
    "What are you doing here? \p"
    "… … … \p"
    "Challenging Marina? \p"
    "Wow, you've really come a long way! \p"
    "I knew you'd do great things with that \n"
    "POKéMON I gave you. \p"
    "Me? Oh, I was just visiting. \p"
    "Marina was a huge influence when I was \n"
    "learning to sing. \p"
    "Well, I'm gonna go now. \p"
    "It was nice running into you, see you \n"
    "later!$"
}