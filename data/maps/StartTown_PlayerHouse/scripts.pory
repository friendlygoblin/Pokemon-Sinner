mapscripts StartTown_PlayerHouse_MapScripts {}

script Bed{
    lock
    msgbox("This is your bed.\pDo you want to take a nap?", MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES){
        applymovement(OBJ_EVENT_ID_PLAYER, GetIntoBed)
        waitmovement(0)
        msgbox(format("It's comfy! Your eyes are closing themselves…"))
        fadescreen(FADE_TO_BLACK)
        playfanfare(MUS_HEAL)
	    waitfanfare
        special(HealPlayerParty)
        setrespawn(HEAL_LOCATION_START_TOWN)
        fadescreen(FADE_FROM_BLACK)
        applymovement(OBJ_EVENT_ID_PLAYER, GetOutOfBed)
        waitmovement(0)
        msgbox(format("You and your POKéMON wake up well rested!"))
    }
    else{
        release
        end
    }
    release
    end
}

movement GetIntoBed{
    walk_right
    face_down
    step_end
}

movement GetOutOfBed{
    walk_left
    step_end
}

script PlayerHouse_Computer{
    lock
    if(flag(FLAG_IS_CHAMPION)){
        msgbox(PlayerHouse_ChampionMail)
    }
    else{
        msgbox(PlayerHouse_MailingList, MSGBOX_AUTOCLOSE)
    }
    release
    end
}

text PlayerHouse_MailingList{
    "You're on The Last Dinner Party's\n"
    "mailing list.\p"
    "The latest message says 'Come challenge\n" 
    "us for the best prize of all!'.$"
}

text PlayerHouse_ChampionMail{
    "The Last Dinner Party sent you an \n"
    "email!\p"
    "'Congratulations, {PLAYER}!\n"
    "You were phenomenal, we had a lot of \l"
    "fun battling with you!\p"
    "You are welcome to all of our shows, \n"
    "and to spar with us anytime you like!'$"
}