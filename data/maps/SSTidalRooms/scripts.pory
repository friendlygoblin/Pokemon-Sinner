raw `
SSTidalRooms_MapScripts::
	.byte 0
`
script ShipRoomsSnatchGiver{
	lock
	faceplayer
	if(flag(FLAG_RECEIVED_TM_SNATCH)) {
		goto(ShipRoomsExplainSnatch)
		}
	else{
		msgbox(NotSuspiciousTakeThis, MSGBOX_DEFAULT)
		checkitemspace(ITEM_TM_SNATCH)
		if (var(VAR_RESULT)==TRUE){
			giveitem(ITEM_TM_SNATCH)
			setflag(FLAG_RECEIVED_TM_SNATCH)
			msgbox(ExplainSnatch, MSGBOX_DEFAULT)			
			}
		}
	release
	end}

script ShipRoomsExplainSnatch{
	msgbox(ExplainSnatch, MSGBOX_DEFAULT)
	release
	end}

script ShipRoomsBed{
	lockall
	msgbox(TakeRestOnBed, MSGBOX_DEFAULT)
	closemessage
	fadescreen(FADE_TO_BLACK)
    playfanfare(MUS_HEAL)
    waitfanfare
    special(HealPlayerParty)
    fadescreen(FADE_FROM_BLACK)
	if(var(VAR_SS_TIDAL_STATE)==0){
		setvar(VAR_SS_TIDAL_STATE, 1)
		playse(SE_DING_DONG)
		waitse
		msgbox(WeveArrived, MSGBOX_AUTOCLOSE)
	}
	elif(var(VAR_SS_TIDAL_STATE)==2){
		setvar(VAR_SS_TIDAL_STATE, 3)
		playse(SE_DING_DONG)
		waitse
		msgbox(WeveArrived, MSGBOX_AUTOCLOSE)
	}
	releaseall
	end}

script ShipRoomsMeinth{
	trainerbattle_single(TRAINER_MEINTH, MeinthIntro, MeinthDefeat)
	msgbox(MeinthPostBattle, MSGBOX_AUTOCLOSE)
	end}

script ShipRoomsBrenae{
	trainerbattle_single(TRAINER_BRENAE, BrenaeIntro, BrenaeDefeat)
	msgbox(BrenaePostBattle, MSGBOX_AUTOCLOSE)
	end}

script ShipRoomsGeorge{
	trainerbattle_single(TRAINER_GEORGE, GeorgeIntro, GeorgeDefeat)
	msgbox(GeorgePostBattle, MSGBOX_AUTOCLOSE)
	end}

script ShipRoomsJed{
	trainerbattle_double(TRAINER_LEA_AND_JED, JedIntro, JedDefeat, JedNotEnoughMons)
	msgbox(JedPostBattle, MSGBOX_AUTOCLOSE)
	end}

script ShipRoomsLea{
	trainerbattle_double(TRAINER_LEA_AND_JED, LeaIntro, LeaDefeat, LeaNotEnoughMons)
	msgbox(LeaPostBattle, MSGBOX_AUTOCLOSE)
	end}

script ShipRoomsGarret{
	trainerbattle_single(TRAINER_GARRET, GarretIntro, GarretDefeat)
	msgbox(GarretPostBattle, MSGBOX_AUTOCLOSE)
	end}

script ShipRoomsTalia{
	trainerbattle_single(TRAINER_TALIA, TaliaIntro, TaliaDefeat)
	msgbox(TaliaPostBattle, MSGBOX_AUTOCLOSE)
	end}

text TakeRestOnBed{
	"There's a bed…\n"
	"Let's take a rest.$"
	}

text WeveArrived{
	"We've arrived!$"
	}

text MeinthIntro{
	"MEINTH: I often sail to Godzilland.\p"
	"I enjoy attending St Vincent's,\n"
	"shows you see.$"
	}

text MeinthDefeat{
	"That was an enjoyable match!$"
	}

text MeinthPostBattle{
	"MEINTH: Travelling for concerts is \n"
	"part of the fun, especially when you \l"
	"meet nice people on the way!$"
	}

text BrenaeIntro{
	"BRENAE: I find the boat's movement \n"
	"soothing, don't you?$"
	}

text BrenaeDefeat{
	"Your friends are, indeed, strong.$"
	}

text BrenaePostBattle{
	"Friends need not be human.\n"
	"For me, POKéMON are treasured friends!$"
	}

text GeorgeIntro{
	"GEORGE: Oh hi again!\p"
	"I'm going to Godzilland to find my \n"
	"neighbour!$"
	}

text GeorgeDefeat{
	"I promise I won't throw a brick at"
	"her!$"
	}

text GeorgePostBattle{
	"GEORGE: I know I sound like I have\n"
	"a problem with bricks but I promise \l"
	"it's not serious!\p"
	"I think… $"
	}

text JedIntro{
	"JED: I feel a little shy about this, but…\n"
	"We'll show you our lovey-dovey power!$"
	}

text JedDefeat{
	"JED: Sigh…$"
	}

text JedPostBattle{
	"JED: It's the first time that our lovey-\n"
	"dovey power couldn't prevail!\l"
	"You must be an awesome TRAINER!$"
	}

text JedNotEnoughMons{
	"JED: You only have one POKéMON?\n"
	"Isn't that just too lonesome?$"
	}

text LeaIntro{
	"LEA: I feel a little silly, but…\n"
	"We'll show you our lovey-dovey power!$"
	}

text LeaDefeat{
	"LEA: Oh, boo!$"
	}

text LeaPostBattle{
	"LEA: I can't believe it!\n"
	"Our lovey-dovey power failed…\l"
	"You must be an awesome TRAINER!$"
	}

text LeaNotEnoughMons{
	"LEA: I wanted to battle…\n"
	"But you don't even have two POKéMON…$"
	}

text GarretIntro{
	"Ah, you've come just in time.\p"
	"I'm bored, you see.\n"
	"You may entertain me.$"
	}

text GarretDefeat{
	"…That will do.$"
	}

text GarretPostBattle{
	"Perhaps I shall get Father to acquire\n"
	"a yacht for me.\l"
	"A yacht for me and POKéMON!$"
	}

text TaliaIntro{
	"TALIA: I love live music so much I'm\n"
	"ready to travel all over the world! $"
	}

text TaliaDefeat{
	"You too? $"
	}

text TaliaPostBattle{
	"TALIA: It gets a little bit expensive\n"
	"travelling to shows, but it's so worth \l"
	"it!$"
	}

text NotSuspiciousTakeThis{
	"Uh… Hi! I… I'm not acting suspicious!\n"
	"Uh… You can have this! For free!\p"
	"It… Honestly, I didn't snatch it from\n"
	"someone! I'd never do such a thing!\l"
	"It's clean! You can use it!$"
	}

text ExplainSnatch{
	"SNATCH steals the beneficial effects\n"
	"of certain moves before they can be\l"
	"used by a foe or ally.$"
	}

script TrashBinTrubbish1{
	lock
	if(flag(FLAG_TEMP_1)){
		msgbox(format("It's empty."), MSGBOX_AUTOCLOSE)
	}
	else{
		msgbox(format("Something's moving at the bottom of the bin!"), MSGBOX_AUTOCLOSE)
		setwildbattle(SPECIES_TRUBBISH, 16, ITEM_LEFTOVERS)
		dowildbattle
		setflag(FLAG_TEMP_1)
	}
}

