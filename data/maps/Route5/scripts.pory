mapscripts Route5_MapScripts {}

script GiveSurf{
    lock
    faceplayer
    if(flag(FLAG_BADGE03_GET)){
        if(flag(FLAG_RECEIVED_HM_SURF)){
            msgbox(SurfStory_GiveSurf, MSGBOX_AUTOCLOSE)
            giveitem(ITEM_HM03)
            setflag(FLAG_RECEIVED_HM_SURF)
            msgbox(ExplainSurf, MSGBOX_AUTOCLOSE)
            }
        else{
            msgbox(ExplainSurf, MSGBOX_AUTOCLOSE)
        }
    }
    else{
        msgbox(SurfStory_CantSurfYet, MSGBOX_AUTOCLOSE)
    }
    releaseall
    end
}

text SurfStory_GiveSurf{
    "Have you ever been on a sinking \n"
    "ship? \p"
    "I have, and let me tell you, I wouldn't \n"
    "be here if it weren't for my POKéMON. \p"
    "I'd recently taught it the move Surf and \n"
    "it saved my life! \p"
    "So here, take this! I'll help you I'm sure!$"
}

text SurfStory_CantSurfYet{
    "Have you ever been on a sinking \n"
    "ship? \p"
    "I have, and let me tell you, I wouldn't \n"
    "be here if it weren't for my POKéMON. \p"
    "I'd recently taught it the move Surf \n"
    "and it saved my life! \p"
    "Hmm, you need a certain level of skill \n"
    "to be able to use this move. \p"
    "Come back when you have a third artist \n"
    "badge! $"
}

text ExplainSurf{
    "The move Surf will allow one of your \n"
    "POKéMON to carry you across water. \p"
    "It's really useful to travel without a \n"
    "boat, just watch out for wild POKéMON! $"
}

script Route5_SwimmerF {
    trainerbattle_single(TRAINER_KYLA, format("The sea is so refreshing!"), format("I'm getting a bit chilly… "))
    msgbox(format("The water isn't that cold if you keep moving… "), MSGBOX_AUTOCLOSE)
}

script Route5_SwimmerM {
    trainerbattle_single(TRAINER_DECLAN, format("I'm the fastest in the water!"), format("I didn't say I was the strongest… "))
    msgbox(format("You must be travelling so fast on your POKéMON's back! "), MSGBOX_AUTOCLOSE)
}

script Route5_Runner {
    trainerbattle_single(TRAINER_MARIA_1, format("Hey, you're in my way!"), format("Ugh, just move aside please… "))
    msgbox(format("I'm training for a marathon, I can't be interrupted."), MSGBOX_AUTOCLOSE)
}