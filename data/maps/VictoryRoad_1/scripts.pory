mapscripts VictoryRoad_1_MapScripts {}

script VictoryRoad_Jay{
    lock
    faceplayer
    msgbox(VictoryRoad_Jay_BattleIntro, MSGBOX_YESNO)
    if(var(VAR_RESULT)==YES){
        trainerbattle_no_intro(TRAINER_JAY_2, format("I think you can win against TLDP!"))
        msgbox(VictoryRoad_Jay_PostBattle, MSGBOX_AUTOCLOSE)
    }
    else{
        msgbox(format("Saving your strength? That's smart, I'll be training here if you change your mind."))
    }
    release
    end
}

text VictoryRoad_Jay_BattleIntro{
    "JAY: {PLAYER}, it's been so long! \p"
    "I knew I'd see you here, we're almost \n"
    "in Mirror City! \p"
    "I'm so much stronger than the first \n"
    "time we met, let me show you! $"
}

text VictoryRoad_Jay_PostBattle{
    "JAY: If I can't win against you now, \n"
    "I'll stand no chance against the band. \p"
    "I'll train here a bit longer, but you \n"
    "go get'em! $"
}

script VictoryRoad_Grace{
    lock
    faceplayer
    msgbox(VictoryRoad_Grace_BattleIntro, MSGBOX_YESNO)
    if(var(VAR_RESULT)==YES){
        trainerbattle_no_intro(TRAINER_GRACE_3, format("Yes, I think you're ready!"))
        msgbox(VictoryRoad_Grace_PostBattle, MSGBOX_AUTOCLOSE)
    }
    else{
        msgbox(format("You're almost there, I'll be here to train with you if you need to."))
    }
    release
    end
}

text VictoryRoad_Grace_BattleIntro{
    "GRACE: {PLAYER}! \p"
    "So this is it, huh? \n"
    "TLDP's at the end of this road! \p"
    "Show me how far you've come! $"
}

text VictoryRoad_Grace_PostBattle{
    "GRACE: Wow, {PLAYER}…  \p"
    "I still remember our first battle in \n"
    "Prelude Town, like it was yesterday… \p"
    "You got this, you can totally win! $"
}

