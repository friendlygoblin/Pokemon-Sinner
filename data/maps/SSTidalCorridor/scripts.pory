mapscripts SSTidalCorridor_MapScripts{}

script ShipCorridor_ExitSailor{
	lock
	faceplayer
	switch (var(VAR_SS_TIDAL_STATE)){
		case 0:
			msgbox(CanRestInCabin2, MSGBOX_AUTOCLOSE)
	
		case 1: 
			msgbox(MadeLandInGodzilland, MSGBOX_AUTOCLOSE)
			warp(MAP_GODZILLAND_HARBOUR_LOBBY, 3, 5)

		case 2:
			msgbox(CanRestInCabin2, MSGBOX_AUTOCLOSE)

		case 3:
			msgbox(MadeLandInBPort, MSGBOX_AUTOCLOSE)
			warp(MAP_BEAUTIFUL_PORT_HARBOUR_LOBBY, 13, 6)
	}
	releaseall
	end
}

script Cabin1_Sign{
	lock 
	msgbox(ShipCorridor_Text_Cabin1, MSGBOX_AUTOCLOSE)
	releaseall
	end
}

script Cabin2_Sign{
	lock 
	msgbox(ShipCorridor_Text_Cabin2, MSGBOX_AUTOCLOSE)
	releaseall
	end
}

script Cabin3_Sign{
	lock 
	msgbox(ShipCorridor_Text_Cabin3, MSGBOX_AUTOCLOSE)
	releaseall
	end
}

script Cabin4_Sign{
	lock 
	msgbox(ShipCorridor_Text_Cabin4, MSGBOX_AUTOCLOSE)
	releaseall
	end
}

script Lookout_Porthole{
	lock 
	msgbox(HorizonSpreadsBeyondPorthole, MSGBOX_AUTOCLOSE)
	releaseall
	end
}

script Ship_Sailor{
	lock
	faceplayer
	msgbox(VisitOtherCabins, MSGBOX_AUTOCLOSE)
	releaseall
	end
}

script Ship_Captain{
	lock
	faceplayer
	msgbox(WelcomeAboard, MSGBOX_AUTOCLOSE)
	releaseall
	end
}

script Ship_Peeko{
	lock
	faceplayer
	playmoncry(SPECIES_WINGULL, CRY_MODE_NORMAL)
	msgbox(Peeko, MSGBOX_AUTOCLOSE)
	waitmoncry
	releaseall
	end
}

text FastCurrentsHopeYouEnjoyVoyage{
	"This ferry is built to plow through\n"
	"fast-running currents.\p"
	"We hope you enjoy your voyage with us.\n"
	"Feel free to explore the ship.$"
	}

text HopeYouEnjoyVoyage{
	"We hope you enjoy your voyage on\n"
	"The Interlude.$"
	}

text MadeLandInBPort{
	"We have made land in Beautiful Port.\n"
	"Thank you for sailing with us.$"
	}

text MadeLandInGodzilland{
	"We have made land in Godzilland.\n"
	"Thank you for sailing with us.$"
	}

text CanRestInCabin2{
	"Welcome aboard The Interlude!\p"
	"It'll be some time before we make land,\n"
	"I reckon.\p"
	"You can rest up in your cabin if you'd\n"
	"like. Your cabin's No. 2.\p"
	"The bed in there is soft and plushy.\n"
	"I can attest to how comfy it is!$"
	}

text VisitOtherCabins{
	"Go visit other cabins.\n"
	"Trainers bored of the boat trip will\l"
	"be itching to battle.$"
	}

text EnjoyYourCruise{
	"Enjoy your cruise!$"
	}

text HorizonSpreadsBeyondPorthole{
	"The horizon spreads beyond\n"
	"the porthole.$"
	}

text WelcomeAboard{
	"Welcome aboard!\p"
	"I'm the captain of The Interlude!\p"
	"Thank you for sailing with us, feel free \n"
	"to explore the ship and meet the other \l"
	"passengers!$"
	}

text Peeko{
	"PEEKO: Reeee eeeee…$"}

