mapscripts FallarborTown_CozmosHouse_MapScripts{}

script Godzilland_House1_Scientist{
	lock
	faceplayer
	msgbox(GodzillandBiodiversity, MSGBOX_AUTOCLOSE)
	release
	end
}

text GodzillandBiodiversity{
	"I'm a biologist.\p"
	"Some POKéMON species can only be found\n"
	"in certain areas.\p"
	"Godzilland has a fascinating ecosystem!$"
}

script Godzilland_House1_ScientistHusband{
	lock
	faceplayer
	msgbox(GodzillandBiodiversity, MSGBOX_AUTOCLOSE)
	release
	end
}

text Godzilland_ScientistHusband{
	"I love POKéMON!\p"
	"When my husband told me we were gonna \n"
	"move to an island full of unique POKéMON \l"
	"I was ecstatic!$"
}