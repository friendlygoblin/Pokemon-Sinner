raw `
.set LOCALID_NURSE, 1

PetalburgCity_PokemonCenter_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, PetalburgCity_PokemonCenter_1F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

PetalburgCity_PokemonCenter_1F_OnTransition:
	setrespawn HEAL_LOCATION_NIGHTINGALE_CITY
	end

PetalburgCity_PokemonCenter_1F_EventScript_Nurse::
	setvar VAR_0x800B, LOCALID_NURSE
	call Common_EventScript_PkmnCenterNurse
	waitmessage
	waitbuttonpress
	release
	end



`
script PetalburgCity_PokemonCenter_1F_EventScript_FatMan{
	lock
	faceplayer
	msgbox(format("I find music stars so impressive.\pThey're good at music AND at POKéMON battles, how do they find the time to practice both?"), MSGBOX_NPC)
	end
	}

script PetalburgCity_PokemonCenter_1F_EventScript_Youngster{
	lock
	faceplayer
	msgbox(format("We all have a favourite POKéMON!\pWho's yours?\nMine is Shroomish"), MSGBOX_NPC)
	end
	}

script IcePunchWoman{
    lock
    faceplayer
    if(flag(FLAG_RECEIVED_TM_ICE_PUNCH)){
        msgbox(format("I like POKéMON Centers, even if I don't battle.\pYou still meet a variety of people!"), MSGBOX_AUTOCLOSE)
    }
    else{
        msgbox(format("My sister is a Battle Girl.\pShe gave me this but I don't do POKéMON battles, so I'll never use it.\pTake it, I insist!"))
        giveitem(ITEM_TM52)
        msgbox("I think it's Fire Punch.\nPretty self explanatory, but I'm not an expert.")
        setflag(FLAG_RECEIVED_TM_ICE_PUNCH)
    }
    release
    end
}
