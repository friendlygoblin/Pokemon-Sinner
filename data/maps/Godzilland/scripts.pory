mapscripts Godzilland_MapScripts {
    MAP_SCRIPT_ON_TRANSITION : Godzilland_Visited
}

script Godzilland_Visited{
    setflag(FLAG_VISITED_LAVARIDGE_TOWN)
}

script Godzilland_CitySign{
    lock
    msgbox(format("Welcome to Godzilland!\pGateway to the unreleased archipelago!"), MSGBOX_AUTOCLOSE)
    releaseall
    end
}

script Godzilland_Route5Sign{
    lock
    msgbox(format("{DOWN_ARROW}: Route 5."), MSGBOX_AUTOCLOSE)
    releaseall
    end
}

script Godzilland_HarbourSign{
    lock
    msgbox(format("Godzilland Harbour.\pNext departure: Beautiful Port."), MSGBOX_AUTOCLOSE)
    releaseall
    end
}

script Godzilland_ConcertHallSign{
    lock
    msgbox(format("GODZILLAND CONCERT HALL\pCURRENT RESIDENT: ST.VINCENT"), MSGBOX_AUTOCLOSE)
    releaseall
    end
}

script Godzilland_DevHouseSign{
    lock
    msgbox(format("POKéMON Sinner Dev House\pCome meet the Dev Team!"), MSGBOX_AUTOCLOSE)
    releaseall
    end
}

script Godzilland_Sailor{
    lock
    faceplayer
    msgbox(format("Today is my day off, but I still come hang out near the Harbour.\pI'd spend the day on the ferry if I could!"), MSGBOX_AUTOCLOSE)
    releaseall
    end
}

script Godzilland_LittleGirl{
    lock
    faceplayer
    msgbox(format("You come from Prelude Town?\pThat's so far away! You must be a great adventurer!"), MSGBOX_AUTOCLOSE)
    releaseall
    end
}

script Godzilland_GiveItemFinder{
    lock
    faceplayer
    if (flag(FLAG_GODZILLAND_ITEM_FINDER)){
        msgbox(FindAnyTreasures, MSGBOX_AUTOCLOSE)
    }
    else{
        msgbox(ExplainHiddenItems)
        giveitem(ITEM_ITEMFINDER)
        msgbox(ExplainItemFinder)
        setflag(FLAG_GODZILLAND_ITEM_FINDER)
    }
    release
    end
}

text ExplainHiddenItems{
    "Hey you! \p"
    "Do you like treasure hunting? \p"
    "No don't say anything, everyone loves \n"
    "treasure hunting! \p"
    "So here, take this! $"
}

text ExplainItemFinder{
    "It's a Dowsing Machine! \p"
    "Some treasures are invisible to the \n"
    "naked eye, but this baby can find them \l"
    "for you! \p"
    "It emits a sound when you're close \n"
    "to a hidden item! \p"
    "Have fun treasure hunting! $"
}

text FindAnyTreasures{
    "So, how's the treasure hunting going? \p"
    "I hope you're finding a lot of cool \n"
    "items!$"
}