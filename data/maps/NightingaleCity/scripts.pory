mapscripts NightingaleCity_MapScripts {
    MAP_SCRIPT_ON_TRANSITION : NightingaleCity_Visited
}

script NightingaleCity_Visited{
    setflag(FLAG_VISITED_LILYCOVE_CITY)
    setvar(VAR_GODZILLAND_PORYGON, 0)
}

script NightingaleCity_PubSign{
    lock
    msgbox(format("The Nightingale Pub \pFresh drinks and good vibes!"))
    release
    end
}

script NightingaleCity_CitySign{
    lock
    msgbox(format("Welcome to Nightingale City! \pDance to the sound of the waves!"))
    release
    end
}

script NightingaleCity_FlowerShopSign{
    lock
    msgbox(format("Nightingale City Flower Shop \pNothing matters but flowers!"))
    release
    end
}

script NightingaleCity_Route10Sign{
    lock
    msgbox(format("{DOWN_ARROW}: Route 10 \pTo Sailor Town."))
    release
    end
}

script NightingaleCity_Route11Sign{
    lock
    msgbox(format("{UP_ARROW}: Route 11 \pTo Mirror Lake."))
    release
    end
}

script NightingaleCity_BugCatcher{
    lock
    faceplayer
    msgbox(format("We don't have a Concert Hall here, \nbut artists sometimes stop by the Nightingale Pub.\pI think I just spotted a famous guitarist in there!"))
    release
    end
}

script NightingaleCity_Elle{
    lock
    faceplayer
    msgbox(NightingaleCity_ElleMoved)
    release
    end
}

text NightingaleCity_ElleMoved{
    "ELLE: I used to live in Ecstasy Town. \p"
    "My old neighbour used to pretend to \n"
    "throw bricks at my house. \p"
    "I'm still getting used to him not being \n"
    "here!$"
}

script NightingaleCity_Sailor{
    lock
    faceplayer
    msgbox(format("The other day I heard a song on the radio that went 'A sailor and a nightingale'.\pI do remember some band stopped by this town a while ago, I wonder if Nighty and I inspired them somehow…"))
    release
    end
}

script NightingaleCity_Nighty{
    lock
    faceplayer
    playmoncry(SPECIES_CORVISQUIRE, CRY_MODE_NORMAL)
    msgbox(format("Nighty: eek eeek!"))
    waitmoncry
    release
    end
}