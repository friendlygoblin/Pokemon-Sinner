raw `
VerdanturfTown_House_MapScripts::
	.byte 0
`
script BigDogIslandHouse_Woman1{
	lock
	faceplayer
	if(flag(FLAG_ITEM_MT_PYRE_6F_TM_SHADOW_BALL)){
		msgbox(ExplainShadowBall, MSGBOX_AUTOCLOSE)
	}
	else{
		msgbox(KnowShadowBall)
		giveitem(ITEM_TM30)
		msgbox(ExplainShadowBall, MSGBOX_AUTOCLOSE)
		setflag(FLAG_ITEM_MT_PYRE_6F_TM_SHADOW_BALL)
	}
	release
	end
}

text KnowShadowBall{
	"I taught my POKéMON a powerful Ghost \n"
	"Type move. \p"
	"And since I'm feeling generous, this \n"
	"is for you!$"
}

text ExplainShadowBall{
	"This move, Shadow Ball, is suuuuper \n"
	"cool! \p"
	"Your POKéMON makes a ball ow darkness \n"
	"and then it goes wooosh BOOM!$"
}