mapscripts Route7_MapScripts {}

const Goblin = 1
const Rora = 8
const Cal = 9

script Route7_Goblin{
    trainerbattle_single(TRAINER_GOBLIN_ROUTE_7, Route7_Goblin_BattleIntro, Route7_Goblin_Defeated, Route7_GoblinLeaves)
}

script Route7_GoblinLeaves {
    lock
    msgbox(Route7_Goblin_PostBattle)
    giveitem(ITEM_TM28)
    msgbox(format("Well I'm gonna go now, I'll see you later! $"), MSGBOX_AUTOCLOSE)
    applymovement(Goblin, Route7_GobLeaves)
    waitmovement(0)
    removeobject(Goblin)
    setflag(FLAG_ROUTE7_GOBLIN)
    releaseall
    end
}

text Route7_Goblin_BattleIntro {
    "GOBLIN: {PLAYER}, wait! \p"
    "How have you been? It's been a \n"
    "while! \p"
    "… … … \p"
    "Defeated Chappell Roan?? \p"
    "No way! \p"
    "You gotta show me how you did that! $"
}

text Route7_Goblin_Defeated{
    "Woah, I see! $"
}

text Route7_Goblin_PostBattle{
    "GOBLIN: That's crazy, {PLAYER}! \p"
    "You've come such a long way in such \n"
    "a short amount of time. \p"
    "The Last Dinner Party better get ready \n"
    "for you! \p"
    "I'm still searching for new POKéMON, \n"
    "it's so cool to see how different \l"
    "species live in different places. \p"
    "Some are rarer than others too so\n"
    "take your time if you don't wanna \l"
    "miss any!\p"
    "Here, I have something cool for you.$"

}

movement Route7_GobLeaves {
    walk_right * 4
    walk_up * 7
    step_end
}

script Route7_Cooltrainer1 {
    trainerbattle_single(TRAINER_ALEXIA, format("We should have a slow and methodical match."), format("You didn't give me the chance to do any strategising."))
    msgbox(format("Sometimes, it's better to take your time and prepare a strategy than to start attacking right away… "), MSGBOX_AUTOCLOSE)
}

script Route7_Cooltrainer2 {
    trainerbattle_single(TRAINER_JODY, format("It's so sunny and dry here… It forges character!"), format("I feel dehydrated… "))
    msgbox(format("Weather affects battles, you know. \pFor example, Fire POKéMON like this sunny weather because it makes them stronger! "), MSGBOX_AUTOCLOSE)
}

script Route7_Hiker {
    trainerbattle_single(TRAINER_DUSTY_1, format("I travel a lot! \pI've seen a lot of different places!"), format("And I've met a lot of people too… "))
    msgbox(format("I like discovering new places and making new friends. \pIt helps you grow as a person! "), MSGBOX_AUTOCLOSE)
}

script Route7_Cyclist {
    trainerbattle_single(TRAINER_JULIO, format("Sports help me let my energy out! \pBut so do POKéMON battles!"), format("Maybe I pushed too hard… "))
    msgbox(format("I have a pretty boring job, so cycling helps keeping my life exciting."), MSGBOX_AUTOCLOSE)
}

script Route7_BlackBelt {
    trainerbattle_single(TRAINER_KOJI_1, format("Patience, focus, discipline… \pI can't lose!"), format("Huh? "), GiveDrainPunch)
    msgbox(format("Training against different opponents makes you stronger! "), MSGBOX_AUTOCLOSE)
}

script GiveDrainPunch{
    msgbox(format("You look strong, you deserve to know my favourite move."))
    giveitem(ITEM_TM53)
    msgbox(format("This move is great! Inflicts damage and drains your opponent's health so you can fight longer!"), MSGBOX_AUTOCLOSE)
    release
    end
}

script Route7_Picnicker {
    trainerbattle_single(TRAINER_MARTHA, format("My favourite thing about travelling is seeing all the pretty POKéMON everywhere!"), format("Ohh your POKéMON are so pretty!"))
    msgbox(format("My POKéMON are the prettiest, but I love discovering new ones."), MSGBOX_AUTOCLOSE)
}

script Route7_Rora{
    lock
    faceplayer
    msgbox(Rora_SomethingMissing)
    applymovement(Rora, WalkInPlaceDown)
    waitmovement(0)
    release
    end
}

script Route7_Cal{
    lock
    faceplayer
    msgbox(Cal_NeedAProp)
    if(checkitem(ITEM_SILK_SCARF)){
        msgbox(Cal_YouHaveProp, MSGBOX_YESNO)
        if(var(VAR_RESULT)==YES){
            msgbox(Cal_LetsTry, MSGBOX_AUTOCLOSE)
            applymovement(Rora, Common_Movement_FaceDown)
            setobjectmovementtype(Rora, MOVEMENT_TYPE_FACE_DOWN)
            applymovement(Cal, Cal_GiveScarfToRora)
            waitmovement(0)
            fadescreen(FADE_TO_BLACK)
            delay(20)
            fadescreen(FADE_FROM_BLACK)
            msgbox(Cal_LastOne, MSGBOX_AUTOCLOSE)
            faceplayer
            msgbox(Cal_Thanks)
            giveitem(ITEM_SHINY_CHARM)
            applymovement(Rora, WalkInPlaceDown)
            msgbox(Rora_Thanks, MSGBOX_AUTOCLOSE)
            fadescreen(FADE_TO_BLACK)
            playse(SE_EXIT)
            waitse
            removeobject(Rora)
            removeobject(Cal)
            setflag(FLAG_ROUTE7_PHOTOSHOOT)
            fadescreen(FADE_FROM_BLACK)
        }
        else{
            msgbox(format("Never mind, then.\nWe'll figure it out."))
        }
    }
    else{
        msgbox("Some kind of scarf? \nI don't know… $", MSGBOX_AUTOCLOSE)
    }
    release
    end
}

movement Cal_GiveScarfToRora{
    walk_in_place_up
    step_end
}

text Rora_SomethingMissing{
    "AURORA: Hey, {PLAYER}!\p"
    "I'm in the middle of a photoshoot with \n"
    "Cal, to promote our Mirror City shows. \p"
    "We got some good shots but I don't \n"
    "know, something's missing… \p"
    "Well, I should get back to it. $"
}

text Rora_Thanks{
    "AURORA: Thank you, {PLAYER}! \p"
    "Now that we're done with this we should \n"
    "go. \p"
    "I'll see you in Mirror City! $"
}

text Cal_NeedAProp{
    "CAL: Hi, I'm Cal McIntyre, director \n"
    "and photographer. \p"
    "I love working with The Last Dinner \n"
    "Party but something's off today. \p"
    "I think we're missing something, like \n"
    "a prop or an accessory that would tie \l"
    "everything together. $"
}

text Cal_YouHaveProp{
    "Wait, is that a Silk Scarf? \n"
    "Can we use it? We'll give it back!$"
}

text Cal_LetsTry{
    "Thank you! \n"
    "Now let's see… $"
}

text Cal_LastOne{
    "CAL: And just a last one… \n"
    "Perfect! $"
}

text Cal_Thanks{
    "Thank you so much, here's your scarf \n"
    "and here's a thank you gift! $"
}