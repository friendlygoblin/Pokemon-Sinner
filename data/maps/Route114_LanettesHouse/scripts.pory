raw `
Route114_LanettesHouse_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, Route114_LanettesHouse_OnTransition
	.byte 0

Route114_LanettesHouse_OnTransition:
	setflag FLAG_LANDMARK_LANETTES_HOUSE
	end
`
script ParlourZine_Amy{
	lock
	faceplayer
	msgbox(ParlourZine_AmyHi)
	applymovement(1, Common_Movement_FaceDown)
	waitmovement(0)
	msgbox(format("… like the game you're playing right now!"), MSGBOX_AUTOCLOSE)
	applymovement(1, Common_Movement_FaceLeft)
	waitmovement(0)
	release
	end
}

text ParlourZine_AmyHi{
	"AMY: Oh hi {PLAYER}! \n"
	"Welcome to the ParlourZine HQ! \p"
	"This is where the magic happens, we \n"
	"work very hard to showcase the best of \l"
	"the Parlour Discord Server…  $"
}

script ParlourZine_Rachel{
	lock
	faceplayer
	msgbox(ParlourZine_RachelHi, MSGBOX_AUTOCLOSE)
	release
	end
}

text ParlourZine_RachelHi{
	"RACHEL: Hi, do you read ParlourZine? \p"
	"In any case, you should really read \n"
	"the editors' notes! \p"
	"I put so much work into those things and \n"
	"NOBODY READS THEM! $"
}

script ParlourZine_Grace{
	lock
	faceplayer
	msgbox(ParlourZine_GraceHi, MSGBOX_AUTOCLOSE)
	release
	end
}

text ParlourZine_GraceHi{
	"GRACE: Oh, {PLAYER}! \n"
	"Didn't expect to see you here! \p"
	"I joined the ParlourZine editor team! \p"
	"Did you know it was originally called \n"
	"Parlour Times and was a weekly thing? \p"
	"Now there's more time between issues \n"
	"but that means we can make them even \l"
	"cooler!$"
}

script ParlourZine_Piplup{
	lock
	applymovement(4, ParlourZine_PiplupJump)
	playmoncry(SPECIES_PIPLUP, CRY_MODE_NORMAL)
	msgbox(ParlourZine_PiplupHelps, MSGBOX_AUTOCLOSE)
	release
	end
}

movement ParlourZine_PiplupJump{
	jump_in_place_left *2
	step_end
}

text ParlourZine_PiplupHelps{
	"PIPLUP: Pipipip! \p"
	"Piplup seems very eager to help Rachel.$"
}

script ParlourZine_Notes1{
	lock
	msgbox(ParlourZine_Notes1_Text, MSGBOX_AUTOCLOSE)
	release
	end
}

text ParlourZine_Notes1_Text{
	"Some notes for the next issue of \n"
	"ParlourZine. \p"
	"Sounds exciting! $"
}

script ParlourZine_Notes2{
	lock
	msgbox(ParlourZine_Notes2_Text, MSGBOX_AUTOCLOSE)
	release
	end
}

text ParlourZine_Notes2_Text{
	"The list of the contributors to the \n"
	"next ParlourZine issue. \p"
	"There are so many of them, this zine \n"
	"really is a big collaborative project!$"
}

script ParlourZine_PC{
	lock
	msgbox(ParlourZine_PC_Text, MSGBOX_AUTOCLOSE)
	release
	end
}

text ParlourZine_PC_Text{
	"The team's inbox is open. \p"
	"There are so many of them, this zine \n"
	"really is a big collaborative project!$"
}