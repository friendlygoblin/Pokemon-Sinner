mapscripts MirrorCity_MapScripts {}

const Goblin = 1

script MirrorCity_CitySign{
    lock
    msgbox(format("Welcome to Mirror City!\pThe city worth climbing a mountain for!"))
    release
    end
}

script MirrorCity_ConcertHallSign{
    lock
    msgbox(format("MIRROR CITY CONCERT HALL\p CURRENT RESIDENT: THE LAST DINNER PARTY"))
    release
    end
}

script MirrorCity_PlaceGoblin1{
    lock
    applymovement(Goblin, MirrorCity_Movement_PlaceGoblin1)
    waitmovement(0)
    goto(MirrorCity_Goblin)
}

script MirrorCity_PlaceGoblin2{
    lock
    applymovement(Goblin, MirrorCity_Movement_PlaceGoblin2)
    waitmovement(0)
    goto(MirrorCity_Goblin)
}

script MirrorCity_Goblin{
    msgbox(MirrorCity_GoblinThisIsIt, MSGBOX_AUTOCLOSE)
    special(HealPlayerParty)
    trainerbattle_no_intro(TRAINER_GOBLIN_MIRROR_CITY, MirrorCity_GoblinDefeat)
    msgbox(MirrorCity_GoblinConcertHallLobby, MSGBOX_AUTOCLOSE)
    applymovement(Goblin, MirrorCity_GoblinLeave)
    waitmovement(0)
    removeobject(Goblin)
    setflag(FLAG_MIRRORCITY_GOBLIN)
    setflag(FLAG_VISITED_EVER_GRANDE_CITY)
    setvar(VAR_MIRROR_CITY_GOBLIN, 1)
    release
    end
}

movement MirrorCity_Movement_PlaceGoblin1{
    walk_down * 5
    step_end
}

movement MirrorCity_Movement_PlaceGoblin2{
    walk_right
    walk_down * 5
    step_end
}

movement MirrorCity_GoblinLeave{
    walk_up * 5
    step_end
}

text MirrorCity_GoblinThisIsIt{
    "GOBLIN: Hi, {PLAYER}.\p"
    "So this is it, huh? \p"
    "We're about to challenge The Last \n"
    "Dinner Party! \p"
    "So many other fans are here, did you \n"
    "see them on Victory Road? \p"
    "I also saw a bunch of other artists \n"
    "walk in! \p"
    "{PLAYER}… \p"
    "You've come such a long way, and I know \n"
    "you're probably ready but… \p"
    "Spar with me before you go in! \p"
    "I'll fix your team up to keep things \n"
    "fair!$"
}

text MirrorCity_GoblinConcertHallLobby{
    "GOBLIN: I knew it! \p"
    "If anyone can win this, it's you! \p"
    "I'll be preparing my strategy in the \n"
    "Concert Hall lobby if you need me. $"
}

text MirrorCity_GoblinDefeat{
    "Yup, you're ready! \n"
    "Go show'em who's the real gunslinger!$"
}

script MirrorCity_Ness{
    lock
    faceplayer
    msgbox(MirrorCity_NessText, MSGBOX_AUTOCLOSE)
    release
    end
}

text MirrorCity_NessText{
    "NESS: You're here to take on the band \n"
    "too? \p"
    "I made it all the way to Lizzie but \n"
    "then they stomped me! \p"
    "I gotta rethink my strategy…$"
}

script MirrorCity_Nat{
    lock
    faceplayer
    msgbox(format("NATALIE: Everyone I saw on the way here is so well dressed!"), MSGBOX_AUTOCLOSE)
    release
    end
}