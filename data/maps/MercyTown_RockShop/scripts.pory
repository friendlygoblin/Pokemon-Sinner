mapscripts MercyTown_RockShop_MapScripts {}

mart RockMart{
    ITEM_KINGS_ROCK
    ITEM_EVIOLITE
    ITEM_EVERSTONE
    ITEM_WATER_STONE
    ITEM_SUN_STONE
    ITEM_LEAF_STONE
    ITEM_MOON_STONE
    ITEM_THUNDER_STONE
}

text SellRocks{
    "Hello! \p"
    "I sell rocks! \p"
    "Have a look, they all have cool \n"
    "effects!$"
}

text ExplainRocks{
    "Alright! \p"
    "Rocks are fascinating, some make POKéMON \n"
    "stronger, others make them evolve… \p"
    "Come back"
}

text NoticeMegaRing{
    "Hello! \p"
    "I sell rocks! \p"
    "Oh! is this a Mega-Ring? \p"
    "Then you must be interested in Mega \n"
    "Stones! \p"
    "I only have one to spare right now, \n"
    "but I'm feeling generous so here you \l"
    "go!$"
}

text ExplainMegaStones{
    "If you have an Ampharos and give it \n"
    "this stone to hold, you'll be able to \l"
    "Mega-Evolve it! \p"
    "Mega-Stones are rare and not every \n"
    "POKéMON can Mega-Evolve, but they are \l"
    "worth the search!$"
}


script RockSellerDude{
    lock 
    faceplayer
    if (var(VAR_SAILORTOWN_NORA)==2){
        msgbox(NoticeMegaRing)
        giveitem(ITEM_AMPHAROSITE)
        msgbox(ExplainMegaStones, MSGBOX_AUTOCLOSE)
        setvar(VAR_SAILORTOWN_NORA, 3)
        release
        end
    }
    message(SellRocks)
    waitmessage
    pokemart(RockMart)
    msgbox(ExplainRocks, MSGBOX_AUTOCLOSE)
    release
    end
}

script RockShop_LittleGirl{
    lock
    faceplayer
    msgbox(DadSellsRocks, MSGBOX_AUTOCLOSE)
    releaseall
    end
}

text DadSellsRocks{
    "My dad loves rocks so much. \p"
    "He finds most of them in the Sunday \n"
    "Cave. \p"
    "Maybe you'll find some too if you go \n"
    "there… \p"
    "Or you can just buy from him!$"
}