mapscripts MercyTown_RockShop_MapScripts {}

mart RockMart_NoMega{
    ITEM_KINGS_ROCK
    ITEM_EVIOLITE
    ITEM_EVERSTONE
    ITEM_WATER_STONE
    ITEM_FIRE_STONE
    ITEM_THUNDER_STONE
    ITEM_DUSK_STONE
    ITEM_MOON_STONE
}

mart RockMart_Mega{
    ITEM_KINGS_ROCK
    ITEM_EVIOLITE
    ITEM_EVERSTONE
    ITEM_WATER_STONE
    ITEM_FIRE_STONE
    ITEM_THUNDER_STONE
    ITEM_DUSK_STONE
    ITEM_MOON_STONE
    ITEM_SHINY_STONE
    ITEM_ALTARIANITE
    ITEM_SALAMENCITE
    ITEM_STEELIXITE
}

text SellRocks{
    "Hello! \p"
    "I sell rocks! \p"
    "Have a look, they all have cool \n"
    "effects!$"
}

text ExplainRocks{
    "Alright! \p"
    "Rocks are fascinating, some make POKéMON \n"
    "stronger, others make them evolve… \p"
    "Come back soon!$"
}

text NoticeMegaRing{
    "Hello! \p"
    "I sell rocks! \p"
    "Oh! is this a Mega-Ring? \p"
    "Then you must be interested in Mega \n"
    "Stones! \p"
    "Barely anyone is interested in them, \n"
    "which is beyond me. \p"
    "So here, for you!$"
}

text ExplainMegaStones{
    "The last people who came to me asking \n"
    "about Mega-Stones were… um… \p"
    "… yes! The Last Dinner Party! \p"
    "I'm a huge fan, so I gave them some for \n"
    "free!\p"
    "Mega-Stones are rare and not every \n"
    "POKéMON can Mega-Evolve, but they are \l"
    "worth the search.\p"
    "My brother sells some in Beautiful Port \n"
    "if you wanna have a look. $"
}


script RockSellerDude{
    lock 
    faceplayer
    if (var(VAR_SAILORTOWN_NORA)==2){
        msgbox(NoticeMegaRing)
        switch(var(VAR_STARTER_MON)){
            case 0:
                giveitem(ITEM_BLAZIKENITE)
            case 1:
                giveitem(ITEM_VENUSAURITE)
            case 2:
                giveitem(ITEM_SWAMPERTITE)
        }
        msgbox(ExplainMegaStones, MSGBOX_AUTOCLOSE)
        setvar(VAR_SAILORTOWN_NORA, 3)
        release
        end
    }
    message(SellRocks)
    waitmessage
    if(flag(FLAG_RECEIVED_MEGARING)){
        pokemart(RockMart_Mega)
    }
    else{
        pokemart(RockMart_NoMega)
    }
    msgbox(ExplainRocks, MSGBOX_AUTOCLOSE)
    release
    end
}

script RockShop_LittleGirl{
    lock
    faceplayer
    msgbox(DadSellsRocks, MSGBOX_AUTOCLOSE)
    releaseall
    end
}

text DadSellsRocks{
    "My dad loves rocks so much. \p"
    "He finds most of them in the Sunday \n"
    "Cave. \p"
    "Maybe you'll find some too if you go \n"
    "there… \p"
    "Or you can just buy from him!$"
}