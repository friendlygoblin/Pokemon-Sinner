}

text VictoryRoad_Morpheus_BattleIntro{
    "MORPHEUS: I'll give it my best, I'll \n"
    "be Caesar on a TV screen! \p"
    "Let me show you! $"
}

text VictoryRoad_Morpheus_PostBattle{
    "MORPHEUS: The band are tough, the only \n"
