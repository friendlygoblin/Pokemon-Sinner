raw `
DewfordTown_House1_MapScripts::
	.byte 0
`

script FurgeTown_House1_EventScript_Man{
	lock
	faceplayer
	if(!flag(FLAG_FURGETOWN_HONEY)){
		msgbox(FurgeTown_House1_GiveHoney, MSGBOX_AUTOCLOSE)
		giveitem(ITEM_HONEY)
		setflag(FLAG_FURGETOWN_HONEY)
	}
	msgbox(FurgeTown_House1_HoneyGiven, MSGBOX_AUTOCLOSE)
	end
	}

script FurgeTown_House1_EventScript_Woman{
	msgbox(FurgeTown_House1_Text_LifeGoesSlowlyOnIsland, MSGBOX_NPC)
	end}

script FurgeTown_House1_EventScript_Zigzagoon{
	lock
	faceplayer
	playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_NORMAL)
	msgbox( FurgeTown_House1_Text_Zigzagoon, MSGBOX_DEFAULT)
	waitmoncry
	release
	end}

text FurgeTown_House1_GiveHoney{
	"I make my own Honey, with the help \n"
	"of the Combees that live in the hive \l"
	"just outside.\p"
	"Here, have a jar, as a welcome gift! $"
	}

text FurgeTown_House1_HoneyGiven{
	"It's 100% organic, and made with love by\n"
	"the Combees.\p"
	"I give them shelter, they give me Honey!\p"
	"And then, I give it to visitors like you!\p"
	"It's so good it attracts wild POKéMON, so \n"
	"you can use it to make new friends!$"
	}


text FurgeTown_House1_Text_LifeGoesSlowlyOnIsland{
	"Life goes by slowly in this little\n"
	"town.\p"
	"But being surrounded by the trees, \n"
	"that's happiness too.$"
	}

text FurgeTown_House1_Text_Zigzagoon{
	"ZIGZAGOON: Guguuh!$"
	}

