mapscripts Godzilland_ConcertHall_Lobby_MapScripts {
    MAP_SCRIPT_ON_LOAD : Godzilland_SetEmilyFlag
    
}

script Godzilland_SetEmilyFlag{
    setflag(FLAG_GODZILLANDHALL_EMILY)
    }

script StVincentHall_Wren{
    lock
    faceplayer
    if(defeated(TRAINER_STVINCENT)){
        msgbox(format("WREN: That was such a great battle!\pSt.Vincent was amazing of course, but you were really cool too!"), MSGBOX_AUTOCLOSE)
        }
    else{
        msgbox(WrenIntro_StVincent, MSGBOX_AUTOCLOSE)
        trainerbattle_no_intro(TRAINER_WREN_2, WrenDefeated_StVincent)
        msgbox(WrenPostBattle_StVincent, MSGBOX_AUTOCLOSE)
        }
    releaseall
    end
}

text WrenIntro_StVincent {
    "WREN: {PLAYER}!\p"
    "Are you here to challenge St.Vincent? \p"
    "I'm sure you got this, but I gotta tell\n"
    "you, she's super strong! \p"
    "How about you warm up with me? $"
}

text WrenDefeated_StVincent{
    "There's no going back… $"
}

text WrenPostBattle_StVincent{
    "WREN: I was so happy to find out \n"
    "St.Vincent had a challenge! \p"
    "I'll definitely come see you battle \n"
    "with her!$"
}

script StVincentHall_Ann{
    lock
    faceplayer
    if(defeated(TRAINER_STVINCENT)){
        msgbox(format("ANN: Wow, what a show!\pAlmost as good as an actual concert!"), MSGBOX_AUTOCLOSE)
        }
    else{
        msgbox(AnnIntro_StVincent, MSGBOX_AUTOCLOSE)
        trainerbattle_no_intro(TRAINER_ANN, AnnDefeated_StVincent)
        msgbox(AnnPostBattle_StVincent, MSGBOX_AUTOCLOSE)
        }
    releaseall
    end
}

text AnnIntro_StVincent {
    "ANN: Hi, I'm Ann!\p"
    "I wanted to see St.Vincent play, but \n"
    "she's only taking challenges at the \l"
    "moment. \p"
    "That's okay, I'll just watch her \n"
    "battle! $"
}

text AnnDefeated_StVincent{
    "I still wish I could see her play… $"
}

text AnnPostBattle_StVincent{
    "ANN: So you're challenging St.Vincent? \p"
    "Then I'll be seeing you battling too! $"
}

script StVincentHall_Receptionist{
    lock
    msgbox(format("Hi, there's no show planned for today.\pSt.Vincent is accepting challenges though, good luck!"))
    release
    end
}

script StVincentHall_Natalie{
    lock
    faceplayer
    msgbox(format("NATALIE: I'm not a trainer, but I still hang out here to encourage challengers!"))
    release
    end
}