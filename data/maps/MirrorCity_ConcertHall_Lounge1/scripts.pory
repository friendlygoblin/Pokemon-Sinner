mapscripts MirrorCity_ConcertHall_Lounge1_MapScripts {}

const Hozier = 1
const Florence = 2
const StVincent = 3
const Chappell = 4
const CMAT = 5
const Marina = 6
const BrianMay = 7

script MCCH_LoungeHozier{
    lock
    faceplayer
    msgbox(LoungeHozier_OfferBattle, MSGBOX_YESNO)
    if(var(VAR_RESULT)==YES){
        msgbox(LoungeHozier_AcceptBattle, MSGBOX_AUTOCLOSE)
        trainerbattle_no_intro(TRAINER_HOZIER_2, format("Either way, it ends… "))
        msgbox(LoungeHozier_PostBattle, MSGBOX_AUTOCLOSE)
    }
    else{
        msgbox(LoungeHozier_RefuseBattle, MSGBOX_AUTOCLOSE)
    }
    applymovement(Hozier, Common_Movement_FaceLeft)
    release
    end
}

text LoungeHozier_OfferBattle{
    "HOZIER: Oh, hello young friend! \p"
    "You've come a long way, that's great! \p"
    "Would you like to tell me about your \n"
    "travels over a friendly battle? \p"
    "Consider it training before you face \n"
    "The Last Dinner Party. $"
    }

text LoungeHozier_RefuseBattle{
    "Very well, perhaps another time… $"
    }

text LoungeHozier_AcceptBattle{
    "Let's do it then, don't hold back! $"
    }

text LoungeHozier_PostBattle{
    "How incredible, you were phenomenal \n"
    "as you were the first time we met! \p"
    "I wish you the best of luck against \n"
    "The Last Dinner Party, even if you \l"
    "may not need it. $"
}

