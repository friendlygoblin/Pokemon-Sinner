mapscripts CrystalStreamCity_MapScripts {
    MAP_SCRIPT_ON_TRANSITION : CSCCH_FlagStuff
}

script CSCCH_FlagStuff{
    setflag(FLAG_LIZZIE_ROUTE6)
    if(var(VAR_SUNDAYCAVE_STATE)==4){
        setflag(FLAG_CSCCH_CHAPPELLDOOR)
    }
}

script CrystalStreamCity_Sign{
    lock
    msgbox(format("Welcome to Crystal Stream City! \pRefresh yourself in the stream and enjoy the Museum!"))
    releaseall
    end
}

script CSCCH_Sign{
    lock
    msgbox(format("CRYSTAL STREAM CITY CONCERT HALL \pCOME CHALLENGE CHAPPELL ROAN"))
    releaseall
    end
}

script MuseumSign{
    lock
    msgbox(format("Sinner Museum \pArt and history all in one place!"))
    releaseall
    end
}

script CSC_Swimmer {
    trainerbattle_single(TRAINER_DAVID, CSC_Swimmer_BattleIntro, CSC_Swimmer_Defeated)
    msgbox(CSC_Swimmer_PostBattle, MSGBOX_AUTOCLOSE)
}

text CSC_Swimmer_BattleIntro{
    "Ahoy, there! Did you visit Big\n"
    "Dog Island, too?$"
    }

text CSC_Swimmer_Defeated{
    "I'm sinking!\n"
    "Glub… Glub…$"
    }

text CSC_Swimmer_PostBattle{
    "Some people even go inside that\n"
    "cave on Big Dog Island.$"
    }