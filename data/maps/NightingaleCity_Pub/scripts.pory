mapscripts NightingaleCity_Pub_MapScripts {}

const Emily = 1

script NCPub_Emily{
    lock
    faceplayer
    msgbox(NCPub_EmilyGreetsPlayer, MSGBOX_AUTOCLOSE)
    applymovement(Emily, NCPub_EmilyGoesToBackRoom)
    waitmovement(0)
    removeobject(Emily)
    setflag(FLAG_NIGHTINGALECITY_PUB_EMILY)
    release
    end
    
}

text NCPub_EmilyGreetsPlayer{
    "EMILY: Hello! \p"
    "Have we met before? \p"
    "… … … \p"
    "Oh I see, we never talked but we did \n"
    "cross paths a few times. \p"
    "Well I'm Emily, and you are? \p"
    "… … … \p"
    "Nice to meet you, {PLAYER}. \p"
    "I'm here to invite someone very special \n"
    "to our first show in Mirror City. \p"
    "He's in the other room, I was thinking \n"
    "of the best way to invite him. \p"
    "I think I'm ready now, wish me luck!$"
}

movement NCPub_EmilyGoesToBackRoom{
    walk_up * 2
    step_end
}

script NightingaleCityPub_Barista{
    lock
    faceplayer
    message("Welcome to the Nightingale Pub, what \ncan I get ya?")
    waitmessage
    pokemart(MartBar)
    msgbox(format("Alright, come back soon!"))
    release
    end
}

script NightingaleCityPub_Toto{
    lock
    faceplayer
    msgbox(format("TOTO: Hi, come here often?\pI'm only stopping by on my way to Mirror City, I'm gonna see The Last Dinner Party.\pSpeaking of, is that Emily Roberts I just saw?\pHow sick!"))
    release
    end
}

script NightingalePub_Tilly{
    lock
    faceplayer
    if(defeated(TRAINER_BRIANMAY)){
        msgbox(format("TILLY: Brian May let you battle with him? \pCool, that's unusual!"), MSGBOX_AUTOCLOSE)
        }
    else{
        msgbox(format("TILLY: Brian May comes here so often he has his own room at the back.\pHe doesn't really do POKéMON battles anymore, but I sure do!"),MSGBOX_AUTOCLOSE)
        trainerbattle_no_intro(TRAINER_TILLY,  format("Love a fun bar fight!"))
        msgbox(format("TILLY: That was fun, and we didn't even make a mess!"), MSGBOX_AUTOCLOSE)
        }
    releaseall
    end
}