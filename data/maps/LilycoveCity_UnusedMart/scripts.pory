raw `
LilycoveCity_UnusedMart_MapScripts::
	.byte 0

`
script CrystalStreamCity_Mart_EventScript_Clerk{
	lock
	faceplayer
	message(gText_HowMayIServeYou)
	waitmessage
	pokemart(CrystalStreamCity_Mart_Pokemart)
	msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
	release
	end
}

mart CrystalStreamCity_Mart_Pokemart{
	ITEM_POKE_BALL
	ITEM_GREAT_BALL
	ITEM_POTION
	ITEM_SUPER_POTION
	ITEM_ANTIDOTE
	ITEM_PARALYZE_HEAL
	ITEM_AWAKENING
	ITEM_FULL_HEAL
	ITEM_REPEL
	ITEM_ESCAPE_ROPE
}