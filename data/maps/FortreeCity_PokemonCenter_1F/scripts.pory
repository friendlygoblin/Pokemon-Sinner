raw `
.set LOCALID_NURSE, 1

FortreeCity_PokemonCenter_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, FortreeCity_PokemonCenter_1F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

FortreeCity_PokemonCenter_1F_OnTransition:
	setrespawn HEAL_LOCATION_MERCY_TOWN
	end

FortreeCity_PokemonCenter_1F_EventScript_Nurse::
	setvar VAR_0x800B, LOCALID_NURSE
	call Common_EventScript_PkmnCenterNurse
	waitmessage
	waitbuttonpress
	release
	end

FortreeCity_PokemonCenter_1F_EventScript_Boy::
	msgbox FortreeCity_PokemonCenter_1F_Text_DoYouKnowAboutPokenav, MSGBOX_NPC
	end

FortreeCity_PokemonCenter_1F_Text_DoYouKnowAboutPokenav:
	.string "GEORGE: I still haven't found my\n"
	.string "neighbour…\p"
	.string "She really moved far from Ecstasy\n"
	.string "Town. \p"
	.string "It can't be just because of the bricks \n"
	.string "I've never actually thrown, right? $"

`

script VoltSwitchKid{
    lock
    faceplayer
    if(flag(FLAG_RECEIVED_TM_VOLT_SWITCH)){
        msgbox(format("Switching POKéMON at the right moment can be the key to winning a battle!"), MSGBOX_AUTOCLOSE)
    }
    else{
        msgbox(format("Sometimes, switching POKéMON is the only way to win a battle.\pBut switching costs a turn, meaning you can't attack your opponent.\pUnless you use this!"))
        giveitem(ITEM_TM64)
        msgbox("Volt Switch allows your POKéMON to attack and switch with another in the same turn!")
        setflag(FLAG_RECEIVED_TM_VOLT_SWITCH)
    }
    release
    end
}

