raw `
SootopolisCity_House2_MapScripts::
	.byte 0

SootopolisCity_House2_EventScript_ExpertF::
	lock
	faceplayer
	msgbox SootopolisCity_House2_Text_CityIsQuiet, MSGBOX_DEFAULT
	release
	end


SootopolisCity_House2_Text_CityIsQuiet:
	.string "This town is so nice and quiet…\p"
	.string "We do get visitors now that Marina is\n"
	.string "here.\p"
	.string "It's nice, it keeps the town alive.$"

`
