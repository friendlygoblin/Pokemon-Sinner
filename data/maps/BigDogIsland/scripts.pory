mapscripts BigDogIsland_MapScripts {
    MAP_SCRIPT_ON_TRANSITION : ClearKatieFlag
}

script ClearKatieFlag{
    setflag(FLAG_VISITED_VERDANTURF_TOWN)
    clearflag(FLAG_BDI_KATIE)
    setvar(VAR_GODZILLAND_PORYGON, 0)
    }

script BDI_Fisherman {
    trainerbattle_single(TRAINER_IVAN, format("I know this place is famous for the dog POKéMON but I prefer fishing! $"), format("I'm good at catching POKéMON, not training them…$"))
    msgbox(format("No one really knows why the POKéMON here are all canines.$"), MSGBOX_AUTOCLOSE)
}

script BDI_TuberGirl {
    trainerbattle_single(TRAINER_LOLA_1, format("I love swimming here with my friends!\nCome join us!$"), format("That was fun but I'm a little tired…$"))
    msgbox(format("Living on an island is so cool, I can go swimming every day!$"), MSGBOX_AUTOCLOSE)
}

script BDI_Birdkeeper{
    trainerbattle_single(TRAINER_PERRY, format("The canine POKéMON always scare the birds away…"), format("My birds…"))
    msgbox(format("I wish there were more birds on this island."), MSGBOX_AUTOCLOSE)
}

script BDI_BattleGirl{
    trainerbattle_single(TRAINER_JOCELYN, format("My team and I train hard in the cave!$"), format("I guess we need more training…"))
    msgbox(format("I came to this island to focus on myself and my POKéMON."), MSGBOX_AUTOCLOSE)
}

script BDI_Woman{
    lock
    faceplayer
    msgbox(format("I never go in the cave.\pI've seen people go in, and I think someone lives on the other side. \pI'm still to scared to try."))
    release
    end
}

script BDI_Man{
    lock
    faceplayer
    msgbox(format("I couldn't pick a better place to retire.\pIt's just me and the wild dogs!"))
    release
    end
}

script BDI_TuberBoy{
    lock
    faceplayer
    msgbox(format("The POKéMON on our island are all canines.\pI wonder if there's a cat island… "))
    release
    end
}

script BDI_Sign{
    lock
    msgbox(format("Welcome to Big Dog Island!\pSo sweet your absence will feel like violence!"))
    release
    end
}